# --- Supabase (backend partagé) ---
SUPABASE_PROJECT_REF=REMPLACER_PAR_ID_PROJET_SUPABASE
SUPABASE_URL=https://REMPLACER_PAR_ID_PROJET_SUPABASE.supabase.co
SUPABASE_ANON_KEY=REMPLACER_PAR_CLE_ANON_SUPABASE
SUPABASE_SERVICE_ROLE_KEY=REMPLACER_PAR_CLE_SERVICE_ROLE_SUPABASE
SUPABASE_DB_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_DB

# --- Clés publiques frontend (préfixe VITE_ exposé au navigateur) ---
VITE_SUPABASE_URL=https://REMPLACER_PAR_ID_PROJET_SUPABASE.supabase.co
VITE_SUPABASE_ANON_KEY=REMPLACER_PAR_CLE_ANON_SUPABASE
VITE_APP_ENV=development

# --- URLs des apps (à adapter par domaine en production) ---
VITE_MANAGER_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174
VITE_MEMBER_URL=http://localhost:5175
VITE_DISCOVER_URL=http://localhost:5176

