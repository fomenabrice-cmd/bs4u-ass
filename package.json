{
  "name": "bs4u-ecosystem",
  "private": true,
  "version": "2.0.0",
  "description": "BS4U Digital Ecosystem — Business Starter For You, Yaoundé, Cameroun",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "db:start": "pnpm --filter backend db:start",
    "db:stop": "pnpm --filter backend db:stop",
    "db:reset": "pnpm --filter backend db:reset",
    "db:test": "pnpm --filter backend db:test",
    "db:types": "pnpm --filter backend db:types",
    "db:push": "pnpm --filter backend db:push",
    "e2e": "turbo e2e",
    "clean": "turbo clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "eslint": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "prettier": "^3.4.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
